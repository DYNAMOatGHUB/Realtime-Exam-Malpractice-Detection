# ============================================================
# ExamGuard AI — FastAPI Backend Dockerfile
# GPU-accelerated inference with CUDA 12.1 + Python 3.11
# ============================================================

FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3 \
    python3-dev \
    python3-pip \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgl1-mesa-glx \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN ln -s /usr/bin/python3 /usr/bin/python || true

WORKDIR /app

# Install Python dependencies first (Docker layer cache)
COPY backend/requirements.txt backend_reqs.txt
COPY ml/requirements.txt ml_reqs.txt

# Step 1: Install all non-torch dependencies (fast, small packages)
RUN python3 -m pip install --upgrade pip && \
    grep -v '^torch' ml_reqs.txt > /tmp/ml_notorch.txt && \
    python3 -m pip install --default-timeout=600 --no-cache-dir \
        -r backend_reqs.txt \
        -r /tmp/ml_notorch.txt

# Step 2: Install PyTorch from the official PyTorch CDN (faster & more reliable than PyPI)
# CUDA 12.1 wheel — matches the base image
RUN python3 -m pip install --default-timeout=600 --no-cache-dir \
        torch==2.5.1 torchvision==0.20.1 torchaudio==2.5.1 \
        --index-url https://download.pytorch.org/whl/cu121

# Copy source
COPY backend/ /app/
COPY ml/ /ml/

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
