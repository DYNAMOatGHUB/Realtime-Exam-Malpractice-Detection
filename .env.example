# ============================================================
# Exam Invigilation Malpractice Detection System
# Environment Configuration Template
# Copy this file to .env and fill in real values before running
# ============================================================

# --- Application ---
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-secret-key
DEBUG=true

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=exam_vigilance
POSTGRES_USER=vigilance_user
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgresql+asyncpg://vigilance_user:change-me-postgres-password@postgres:5432/exam_vigilance

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- MinIO (S3-compatible object storage) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio-password
MINIO_BUCKET_EVIDENCE=evidence-frames
MINIO_BUCKET_MODELS=model-weights
MINIO_SECURE=false

# --- Gmail SMTP (free tier, App Password required) ---
# Create an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_NAME=Exam Vigilance System
DAILY_EMAIL_LIMIT=100

# --- ML Model Paths (inside container) ---
YOLO_MODEL_PATH=/app/ml/weights/yolov11n.pt
POSE_MODEL_PATH=/app/ml/weights/yolov11n-pose.pt
LSTM_MODEL_PATH=/app/ml/weights/lstm_classifier.pt
USE_TENSORRT=false
TENSORRT_YOLO_PATH=/app/ml/weights/yolov11n.engine
TENSORRT_LSTM_PATH=/app/ml/weights/lstm_classifier.engine

# --- Inference Settings ---
FRAME_SAMPLE_RATE=8          # frames per second to sample from RTSP
SEQUENCE_WINDOW_SECONDS=10   # temporal window for LSTM (seconds)
MAX_CAMERAS=5                # maximum concurrent RTSP streams
CELERY_WORKERS=2             # number of GPU inference workers

# --- Confidence Thresholds ---
HIGH_CONFIDENCE_THRESHOLD=0.85   # auto-alert above this
LOW_CONFIDENCE_THRESHOLD=0.40    # discard below this

# --- Django ---
DJANGO_SECRET_KEY=change-me-django-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
FASTAPI_BASE_URL=http://fastapi:8000

# --- Ports (for local dev without Docker) ---
FASTAPI_PORT=8000
DJANGO_PORT=8001
