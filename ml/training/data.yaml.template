# ExamGuard AI — YOLOv8 Dataset Configuration
# ================================================
# This file is auto-generated by Roboflow when you export in YOLOv8 format.
# It is shown here so you know what to expect.
#
# After exporting from Roboflow, the structure will be:
#
#   exam-anomaly-v1/
#   ├── data.yaml         ← this file
#   ├── train/
#   │   ├── images/       ← training images (.jpg)
#   │   └── labels/       ← YOLO annotation .txt files
#   ├── valid/
#   │   ├── images/
#   │   └── labels/
#   └── test/
#       ├── images/
#       └── labels/
#
# Each .txt label file has one row per bounding box:
#   <class_id> <x_center> <y_center> <width> <height>
#   (all values normalized 0–1 relative to image size)
#
# Example label file for an image with two anomalies:
#   0 0.523 0.412 0.180 0.340    ← class 0 (COPYING) at center (52%, 41%)
#   2 0.750 0.620 0.120 0.220    ← class 2 (MOBILE_PHONE) at (75%, 62%)

# Dataset paths (Roboflow fills these automatically)
path:  /content/exam-anomaly-v1     # root directory of the dataset
train: train/images
val:   valid/images
test:  test/images                  # optional

# Number of classes
nc: 8

# Class names — MUST be in the same order as used during annotation
# Roboflow sorts these alphabetically by default
names:
  0: COPYING
  1: LEAVING_SEAT
  2: MOBILE_PHONE
  3: OTHER
  4: PASSING_NOTES
  5: SUSPICIOUS
  6: TALKING
  7: UNAUTH_MATERIAL
