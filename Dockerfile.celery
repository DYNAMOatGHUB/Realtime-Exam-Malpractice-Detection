# ============================================================
# ExamGuard AI — Celery Worker Dockerfile
# Shares the same CUDA base as the backend for GPU inference
# ============================================================

FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3 \
    python3-dev \
    python3-pip \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgl1-mesa-glx \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN ln -s /usr/bin/python3 /usr/bin/python || true

WORKDIR /app

COPY backend/requirements.txt backend_reqs.txt
COPY ml/requirements.txt ml_reqs.txt

# Step 1: Install all non-torch dependencies
RUN python3 -m pip install --upgrade pip && \
    grep -v '^torch' ml_reqs.txt > /tmp/ml_notorch.txt && \
    python3 -m pip install --default-timeout=600 --no-cache-dir \
        -r backend_reqs.txt \
        -r /tmp/ml_notorch.txt

# Step 2: PyTorch from official CDN (more reliable than PyPI for large downloads)
RUN python3 -m pip install --default-timeout=600 --no-cache-dir \
        torch==2.5.1 torchvision==0.20.1 torchaudio==2.5.1 \
        --index-url https://download.pytorch.org/whl/cu121

COPY backend/ /app/
COPY ml/ /ml/

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Celery worker with GPU concurrency=1 (single GPU thread)
CMD ["celery", "-A", "app.celery_app", "worker", \
     "--loglevel=info", \
     "--concurrency=1", \
     "--pool=solo", \
     "-Q", "inference,frames,alerts"]
